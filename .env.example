# Copy to .env. The relay reads .env from the directory it runs in (or a
# parent); values already set in the environment take precedence.

# Database (docker compose reads POSTGRES_PASSWORD; use the same one below)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://artemis:change-me@localhost:5432/artemis

# Server. Loopback by default: set 0.0.0.0:3000 only behind a TLS proxy.
BIND_ADDR=127.0.0.1:3000

# Client ID of a GitHub OAuth app (https://github.com/settings/developers)
# with "Enable Device Flow" checked. The device flow needs no client secret
# and no callback URL. Required: the relay refuses to start while it is empty.
GITHUB_CLIENT_ID=

# Log level (trace, debug, info, warn, error). Defaults to info.
# RUST_LOG=info
